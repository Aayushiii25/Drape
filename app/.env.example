# ──────────────────────────────────────────────
# DRAPE — Environment Configuration
# ──────────────────────────────────────────────

# App
APP_NAME=Drape
DEBUG=true

# WhatsApp Cloud API (get these from Meta Developer Dashboard)
WHATSAPP_TOKEN=your_whatsapp_access_token_here
WHATSAPP_VERIFY_TOKEN=drape_verify_secret_2024
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# Savana
SAVANA_BASE_URL=https://api-shop-in.savana.com
SAVANA_TIMEOUT=10.0
SAVANA_MAX_RETRIES=3

# Server
HOST=0.0.0.0
PORT=8000
